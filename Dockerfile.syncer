# Tasker syncer: runs AI sync for users on a Claude Code or Codex subscription.
# Built from the repo root (RAILWAY_DOCKERFILE_PATH=Dockerfile.syncer) because
# it imports src/lib/agent directly instead of duplicating the sync runner.
FROM node:22-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates git \
  && rm -rf /var/lib/apt/lists/*

RUN npm install -g @anthropic-ai/claude-code @openai/codex

WORKDIR /app
COPY package.json package-lock.json ./
# tsx is a devDependency; Railway sets NODE_ENV=production.
RUN npm ci --include=dev --no-audit --no-fund

COPY tsconfig.json tsconfig.syncer.json ./
COPY src/lib ./src/lib
COPY src/types ./src/types
COPY syncer ./syncer

# Per-user CODEX_HOME / CLAUDE_CONFIG_DIR and scratch dirs; mount a Railway volume here.
ENV DATA_DIR=/data
ENV MALLOC_ARENA_MAX=2

CMD ["npx", "tsx", "syncer/index.ts"]
