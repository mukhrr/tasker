# Tasker syncer: runs AI sync for users on a Claude Code or Codex subscription.
# Built from the repo root (RAILWAY_DOCKERFILE_PATH=Dockerfile.syncer) because
# it imports src/lib/agent directly instead of duplicating the sync runner.
FROM node:22-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates git \
  && rm -rf /var/lib/apt/lists/*

RUN npm install -g @anthropic-ai/claude-code @openai/codex

WORKDIR /app
COPY package.json package-lock.json ./
# npm install, not ci: package-lock has a pre-existing commander dedupe that
# ci rejects. --include=dev because Railway sets NODE_ENV=production and tsx
# is a devDependency.
RUN npm install --include=dev --no-audit --no-fund

COPY tsconfig.json tsconfig.syncer.json ./
COPY src/lib ./src/lib
COPY src/types ./src/types
COPY syncer ./syncer

# Per-user CODEX_HOME / CLAUDE_CONFIG_DIR and scratch dirs; mount a Railway volume here.
ENV DATA_DIR=/data
ENV MALLOC_ARENA_MAX=2

# node --import tsx, not npx tsx: the npm and tsx launcher processes held ~125 MB for nothing.
CMD ["node", "--import", "tsx", "syncer/index.ts"]
